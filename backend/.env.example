# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development          # development | production | test

# ── Frontend (CORS + liens emails) ────────────────────────────────────────────
# Plusieurs origines séparées par des virgules
FRONTEND_URL=http://localhost:5173

# ── Base de données MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=finance_db

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=changez_moi_en_production_avec_une_cle_aleatoire_64_bytes
JWT_EXPIRES_IN=7d             # Durée de validité du token (ex: 7d, 24h)

# ── SMTP — emails transactionnels (optionnel) ─────────────────────────────────
# Sans SMTP : les comptes sont auto-vérifiés, les emails de reset/confirmation ne sont pas envoyés.
# Exemple Gmail : utilisez un "mot de passe d'application" (pas votre vrai mdp).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false             # true pour le port 465 (SSL)
SMTP_USER=votre_email@gmail.com
SMTP_PASS=votre_mot_de_passe_application
SMTP_FROM="FinanceApp <votre_email@gmail.com>"

# ── Logs ──────────────────────────────────────────────────────────────────────
LOG_LEVEL=info                # error | warn | info | debug
